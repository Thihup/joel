<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.thihup.joel</groupId>
        <artifactId>parent</artifactId>
        <version>1.0.0-M1</version>
    </parent>

    <artifactId>tck</artifactId>
    <version>1.0.0-M1</version>

    <properties>
        <tck.version>6.0.1</tck.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.thihup.joel</groupId>
            <artifactId>jakarta.el</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.thihup.joel</groupId>
            <artifactId>dev.thihup.joel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.tck</groupId>
            <artifactId>sigtest-maven-plugin</artifactId>
            <version>2.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>download-and-unpack-tck</id>
                        <phase>generate-test-resources</phase>
                        <configuration>
                            <target>
                                <get src="https://download.eclipse.org/jakartaee/expression-language/6.0/jakarta-expression-language-tck-${tck.version}.zip"
                                     dest="${project.build.directory}/tck.zip" skipexisting="true"/>
                                <unzip src="${project.build.directory}/tck.zip"
                                       dest="${project.build.directory}">
                                    <patternset>
                                        <include name="el-tck/artifacts/jakarta-expression-language-tck-${tck.version}.jar"/>
                                    </patternset>
                                </unzip>
                                <unzip src="${project.build.directory}/el-tck/artifacts/jakarta-expression-language-tck-${tck.version}.jar"
                                       dest="${project.build.directory}/test-classes"/>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M5</version>
                <configuration>
                    <includes>
                        <include>**/*IT.class</include>
                    </includes>
                    <systemPropertyVariables>
                        <variable.mapper>dev.thihup.joel.impl.mapper.JoelVariableMapper</variable.mapper>
                        <jimage.dir>${project.build.directory}/jimage</jimage.dir>
                        <sigTestClasspath>${settings.localRepository}/dev/thihup/joel/jakarta.el/${project.version}/jakarta.el-${project.version}.jar${path.separator}${project.build.directory}/jimage/java.base</sigTestClasspath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
